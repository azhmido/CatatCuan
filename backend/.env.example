# ============================================================
# CatatCuan Backend — Environment Variables Example
# Salin file ini menjadi application.properties dan isi nilainya.
# JANGAN commit file dengan credential asli ke repository!
# ============================================================

spring.datasource.url=jdbc:postgresql://localhost:5432/catatcuan_db
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

# JWT secret — minimal 256-bit (32 karakter), gunakan random string panjang di production
app.jwt.secret=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
app.jwt.expiration-ms=86400000

