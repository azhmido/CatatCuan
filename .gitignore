# Root Gitignore for CatatCuan Full-Stack Project

# ================================
# OS & IDE Files
# ================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
*.iws
*.ipr

# ================================
# Backend (Spring Boot / Maven)
# ================================
backend/target/
**/target/
*.class
.mvn/wrapper/maven-wrapper.jar
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
build/

# ================================
# Frontend (React Vite / Node)
# ================================
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
dist-ssr/
*.tsbuildinfo

# ================================
# Logs
# ================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ================================
# Credentials & Secret Configurations
# (Jangan pernah commit file .env lokal ke repositori publik)
# ================================
.env
.env.local
.env.*.local
*.env
!backend/src/main/resources/application.properties.example
!frontend/.env.example