          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PT Digital Inovasi Bangsa\",\n  \"contact\": \"081298765432\",\n  \"address\": \"Jl. MH Thamrin No. 9, Jakarta Pusat\"\n}"
