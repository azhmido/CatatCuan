            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients?search=digital",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"],
              "query": [
                { "key": "search", "value": "digital" }
              ]
            }
          }
        },
        {
          "name": "Sort Clients (Ascending / Descending)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients?sortBy=name&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients"],
              "query": [
                { "key": "sortBy", "value": "name" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Update Client",
