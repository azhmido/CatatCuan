            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PT Digital Inovasi Bangsa (Pusat)\",\n  \"contact\": \"081298765432\",\n  \"address\": \"Gedung Cyber 2 Lt. 14, Kuningan, Jakarta Selatan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients/{{clientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients", "{{clientId}}"]
